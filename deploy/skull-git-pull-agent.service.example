[Unit]
Description=Skull pull-based immutable Git deployment
After=network-online.target skull-candidate.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/skull/deploy.env
ExecStart=/usr/local/libexec/skull-git-pull-agent.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
