+                    panelBadge.textContent = primaryBadge.textContent || "—";
+                    panelBadge.className = primaryBadge.className;
+                };
+
+                const observer = new MutationObserver(syncBadge);
+                observer.observe(primaryBadge, {
+                    characterData: true,
+                    childList: true,
+                    subtree: true,
+                    attributes: true,
+                    attributeFilter: ["class"]
+                });
+
+                syncBadge();
+            }
+        })();
