-  const sanitized = [];
-  if (Array.isArray(assignments)) {
-    for (let idx = 0; idx < total; idx += 1) {
-      const value = assignments[idx];
-      sanitized.push(typeof value === "string" ? value.trim() : "");
-    }
-  } else {
-    for (let idx = 0; idx < total; idx += 1) {
