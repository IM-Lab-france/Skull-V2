+
+      topState = "offline";
+      sliderTarget = 0;
+    } else {
+      statusClass += " is-unknown";
+
+      topState = "unknown";
+    }
+  } else {
+    statusClass += " is-unknown";
+
+    topState = "unknown";
+  }
+
+  if (elBtStatus) {
+    elBtStatus.className = statusClass;
+  }
+
+  if (elBtStatusDot) {
