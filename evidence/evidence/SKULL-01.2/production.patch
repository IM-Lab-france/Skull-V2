+    padding: 6px 12px;
+    border-radius: 999px;
+    border: 1px solid var(--border);
+    background: rgba(255, 255, 255, .04)
+}
+
+.esp32-dot {
+    width: 10px;
+    height: 10px;
+    border-radius: 50%;
+    background: var(--muted);
+    box-shadow: 0 0 8px rgba(0, 0, 0, .4);
+    transition: background .3s ease, box-shadow .3s ease, opacity .3s ease
+}
+
+.esp32-dot.online {
+    background: var(--success);
+    box-shadow: 0 0 10px rgba(40, 167, 69, .45)
+}
+
+.esp32-dot.offline {
+    background: var(--danger);
+    box-shadow: 0 0 10px rgba(220, 53, 69, .45)
+}
+
+.esp32-dot.disabled {
+    background: var(--muted);
+    opacity: .45;
+    box-shadow: none
+}
+
+.esp32-status-text {
+    font-weight: 600
+}
+
+.esp32-config {
+    display: flex;
+    flex-direction: column;
+    gap: 12px
+}
+
+.esp32-config-row {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+    flex-wrap: wrap
+}
+
+.esp32-field {
+    flex: 0 0 auto;
+    min-width: 120px
+}
+
+.esp32-field .input {
+    width: 110px
+}
+
+.esp32-enabled {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    cursor: pointer;
+    user-select: none
+}
+
+.esp32-buttons-group {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 10px
+}
+
+.esp32-status-panel {
+    display: flex;
+    flex-direction: column;
+    gap: 12px
+}
+
+.esp32-subtitle {
+    margin: 0;
+    font-size: 1rem
+}
+
+.esp32-status-grid .badge {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    min-width: 56px;
+    text-transform: uppercase;
+    letter-spacing: .04em
+}
+
+.esp32-badge-on {
+    background: var(--success);
+    color: #000
+}
+
+.esp32-badge-off {
+    background: var(--danger);
+    color: #fff
+}
+
+.esp32-badge-idle {
+    background: rgba(255, 255, 255, .18);
+    color: var(--fg)
+}
+
+.status-box.esp32-status-raw {
+    max-height: 140px;
+    overflow-y: auto;
+    font-size: .85rem;
+    background: rgba(0, 0, 0, .35)
+}
+
+.panel-section {
+    display: flex;
+    flex-direction: column;
+    gap: 16px;
+}
+
+.panel-section+.panel-section {
+    margin-top: 24px;
+}
+
+.panel-section h3 {
+    margin: 0 0 12px;
+}
+
+.side-panel,
+.left-panel {
+    position: fixed;
+    top: 0;
+    width: 520px;
+    height: 100vh;
+    background: rgba(11, 15, 22, 0.96);
+    backdrop-filter: blur(14px);
+    transition: transform 0.3s ease;
+    z-index: 1600;
+    overflow-y: auto;
+    border: 1px solid rgba(255, 255, 255, 0.06);
+}
+
+.side-panel {
+    right: 0;
+    border-left-width: 0;
+    box-shadow: -6px 0 24px rgba(0, 0, 0, 0.55);
+    transform: translateX(100%);
+}
+
+.left-panel {
+    left: 0;
+    border-right-width: 0;
+    box-shadow: 6px 0 24px rgba(0, 0, 0, 0.55);
+    transform: translateX(-100%);
+}
+
+.side-panel.is-open,
+.left-panel.is-open {
+    transform: translateX(0);
+}
+
+.side-panel-content,
+.left-panel-content {
+    padding: 32px;
+    padding-top: 120px;
+    display: flex;
+    flex-direction: column;
+    gap: 28px;
+}
+
+.side-panel-content h2,
+.left-panel-content h2 {
+    margin: 0;
+    font-size: 1.4rem;
+}
+
+.panel-toggle {
+    position: fixed;
+    top: 96px;
+    z-index: 2500;
+    width: 52px;
+    height: 52px;
+    border-radius: 50%;
+    border: 2px solid var(--border);
+    cursor: pointer;
+    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35);
+    transition: transform 0.2s, right 0.3s, left 0.3s;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    font-size: 1.45rem;
+}
+
+.panel-toggle:hover {
+    transform: scale(1.08);
+}
+
+.side-panel-toggle {
+    right: 16px;
+    background: var(--orange);
+    color: #000;
+}
+
+.left-panel-toggle {
+    left: 16px;
+    background: var(--danger);
+    color: #fff;
+}
+
+.side-panel.is-open+.side-panel-toggle {
+    right: 544px;
+}
+
+.left-panel.is-open+.left-panel-toggle {
+    left: 544px;
+}
+
+@media (max-width: 720px) {
+    .container {
+        padding-left: 12px;
+        padding-right: 12px;
+    }
+
+    .site-header {
+        padding: 16px;
+    }
+
+    .site-header-main {
+        flex-direction: column;
+        align-items: flex-start;
+        gap: 12px;
+    }
+
+    .panel-toggle {
+        top: 92px;
+    }
+
+    .controls-inline .btn,
+    .volume-controls .btn,
+    .maintenance-actions .btn,
+    .picker-row .btn,
+    .esp32-buttons-group .btn {
+        min-height: 44px;
+    }
+
+    .playback-status {
+        flex-direction: column;
+        align-items: flex-start;
+        gap: 8px;
+    }
+
+    .volume-controls {
+        justify-content: space-between;
+    }
+
+    .side-panel,
+    .left-panel {
+        width: 100%;
+    }
+
+    .side-panel.is-open+.side-panel-toggle {
+        right: 12px;
+    }
+
+    .left-panel.is-open+.left-panel-toggle {
+        left: 12px;
+    }
+}
+
+
+/* ================== Loop volume slider ================== */
+.loop-panel .loop-volume {
+    margin-top: 0.75rem;
+    padding: 0.75rem;
+    border-radius: 12px;
+    background: rgba(255, 255, 255, 0.04);
+    border: 1px solid rgba(255, 255, 255, 0.08);
+}
+
+.loop-panel .loop-volume .label {
+    display: block;
+    font-size: 0.9rem;
+    opacity: 0.9;
+    margin-bottom: 0.5rem;
+}
+
+.loop-panel .loop-volume-slider {
+    display: flex;
+    align-items: center;
+    gap: 0.75rem;
+}
+
+/* valeur affichée à droite (ex: 73) */
+.loop-panel .loop-volume-value {
+    min-width: 2ch;
+    text-align: right;
+    font-variant-numeric: tabular-nums;
+    font-weight: 600;
+    opacity: 0.9;
+}
+
+/* ---- Track commun ---- */
+#loopVolumeSlider {
+    -webkit-appearance: none;
+    appearance: none;
+    width: 240px;
+    max-width: 100%;
+    height: 6px;
+    border-radius: 999px;
+    background: linear-gradient(90deg, rgba(255, 165, 0, 0.9), rgba(255, 105, 0, 0.9));
+    outline: none;
+    transition: box-shadow .15s ease;
+}
+
+#loopVolumeSlider:focus {
+    box-shadow: 0 0 0 3px rgba(255, 165, 0, 0.25);
+}
+
+#loopVolumeSlider:disabled {
+    opacity: .6;
+    cursor: not-allowed;
+}
+
+/* ---- Thumb WebKit ---- */
+#loopVolumeSlider::-webkit-slider-thumb {
+    -webkit-appearance: none;
+    appearance: none;
+    width: 18px;
+    height: 18px;
+    border-radius: 50%;
+    background: var(--accent, #ffae00);
+    border: 2px solid rgba(0, 0, 0, 0.6);
+    cursor: pointer;
+    transition: transform .12s ease;
+}
+
+#loopVolumeSlider::-webkit-slider-thumb:active {
+    transform: scale(1.05);
+}
+
+/* ---- Thumb Firefox ---- */
+#loopVolumeSlider::-moz-range-thumb {
+    width: 18px;
+    height: 18px;
+    border-radius: 50%;
+    background: var(--accent, #ffae00);
+    border: 2px solid rgba(0, 0, 0, 0.6);
+    cursor: pointer;
+    transition: transform .12s ease;
+}
+
+#loopVolumeSlider::-moz-range-thumb:active {
+    transform: scale(1.05);
+}
+
+/* Track Firefox */
+#loopVolumeSlider::-moz-range-track {
+    height: 6px;
+    border-radius: 999px;
+    background: linear-gradient(90deg, rgba(255, 165, 0, 0.9), rgba(255, 105, 0, 0.9));
+}
+
+/* Responsive: étire le slider sur mobile */
+@media (max-width: 640px) {
+    .loop-panel .loop-volume-slider {
+        gap: 0.6rem;
+    }
+
+    #loopVolumeSlider {
+        width: 100%;
+    }
+}
