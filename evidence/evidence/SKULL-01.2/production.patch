-
-    host = config.get("host", "").strip()
-    if not host:
-        raise ESP32ConfigError("Aucune adresse ESP32 configuree.")
-
-    port = config.get("port") or 80
-    try:
-        port = int(port)
-    except (TypeError, ValueError):
-        port = 80
