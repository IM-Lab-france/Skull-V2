+/* ========= Thème Halloween (animé) ========= */
+:root {
+    --bg1: #0b0f16;
+    --fg: #e6edf3;
+    --muted: rgba(230, 237, 243, .65);
+    --border: rgba(255, 255, 255, .08);
+    --card: rgba(255, 255, 255, .03);
+    --accent: #6aa1ff;
+    --orange: #ff7a18;
+    --orange-light: #ff9a3d;
+    --purple: #6a00ff;
+    --green: #39ff14;
+    --danger: #dc3545;
+    --warning: #f0ad4e;
+    --success: #28a745;
+}
+
+* {
+    box-sizing: border-box
+}
+
+html,
+body {
+    height: 100%;
+    margin: 0
+}
+
+body.theme-halloween {
+    font-family: "Inter", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
+    color: var(--fg);
+
+    /* Fond changeant (halos) */
+    background:
+        radial-gradient(900px 600px at 20% 20%, rgba(255, 122, 24, .25), transparent 70%),
+        radial-gradient(800px 500px at 80% 30%, rgba(106, 0, 255, .25), transparent 70%),
+        radial-gradient(1000px 700px at 50% 110%, rgba(50, 255, 80, .22), transparent 80%),
+        var(--bg1);
+    background-attachment: fixed;
+    animation: halloween-bg 22s infinite alternate ease-in-out;
+    position: relative;
+    overflow-x: hidden;
+}
+
+@keyframes halloween-bg {
+    0% {
+        filter: hue-rotate(0deg) brightness(1)
+    }
+
+    35% {
+        filter: hue-rotate(-15deg) brightness(1.08)
+    }
+
+    70% {
+        filter: hue-rotate(12deg) brightness(1.02)
+    }
+
+    100% {
+        filter: hue-rotate(25deg) brightness(.95)
+    }
+}
+
+/* Couches animées supplémentaires (plus de “vie”) */
+body.theme-halloween::before,
+body.theme-halloween::after {
+    content: "";
+    position: fixed;
+    inset: -10%;
+    pointer-events: none;
+    z-index: 0
+}
+
+/* Orbes flottants */
+body.theme-halloween::before {
+    background:
+        radial-gradient(18rem 14rem at 12% 18%, rgba(255, 122, 24, .25), transparent 60%),
+        radial-gradient(16rem 12rem at 82% 26%, rgba(106, 0, 255, .22), transparent 60%),
+        radial-gradient(18rem 14rem at 52% 88%, rgba(50, 255, 80, .18), transparent 60%);
+    filter: blur(8px);
+    animation: float-orbs 18s ease-in-out infinite alternate;
+    opacity: .55
+}
+
+@keyframes float-orbs {
+    0% {
+        transform: translate3d(0, 0, 0) scale(1)
+    }
+
+    100% {
+        transform: translate3d(0, -12px, 0) scale(1.03)
+    }
+}
+
+/* disque conique très léger qui tourne (teinte globale) */
+body.theme-halloween::after {
+    background: conic-gradient(from 0deg at 50% 50%,
+            rgba(255, 122, 24, .08),
+            rgba(106, 0, 255, .06),
+            rgba(50, 255, 80, .06),
+            rgba(255, 122, 24, .08));
+    mix-blend-mode: soft-light;
+    animation: conic-rotate 60s linear infinite;
+    opacity: .35
+}
+
+@keyframes conic-rotate {
+    to {
+        transform: rotate(360deg)
+    }
+}
+
+.container {
+    max-width: 1400px;
+    margin: 0 auto;
+    padding: 121px 24px;
+    margin-top: 0px;
+}
+
+/* ========= Header & Footer ========= */
+.site-header {
+    position: fixed;
+    top: 0;
+    left: 0;
+    right: 0;
+    z-index: 2000;
+    background: rgba(11, 15, 22, 0.95);
+    backdrop-filter: blur(16px);
+    border-bottom: 1px solid var(--border);
+    padding: 18px 32px;
+}
+
+.site-header-main {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: space-between;
+    gap: 16px 32px;
+}
+
+.site-title {
+    display: flex;
+    flex-direction: column;
+    gap: 4px;
+}
+
+.site-header h1 {
+    margin: 0 0 8px;
+    font-size: 2rem
+}
+
+.subtitle {
+    margin: 0;
+    color: var(--muted)
+}
+
+.site-footer {
+    text-align: center;
+    padding: 16px;
+    color: var(--muted)
+}
+
+.sr-only {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    padding: 0;
+    margin: -1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+    white-space: nowrap;
+    border: 0;
+}
+
+/* ========= Layout principal ========= */
+.layout {
+    display: grid;
+    gap: 10px;
+    align-items: start;
+    grid-template-columns: 1fr;
+}
+
+.layout .full-width {
+    grid-column: 1 / -1;
+}
+
+@media (min-width: 900px) and (max-width: 1399px) {
+    .layout {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+    }
+}
+
+@media (min-width: 1400px) {
+    .layout {
+        grid-template-columns: repeat(3, minmax(0, 1fr));
+    }
+}
+
+/* ========= Cards ========= */
+.card {
+    background: var(--card);
+    border: 1px solid var(--border);
+    border-radius: 14px;
+    padding: 20px;
+    box-shadow: 0 12px 30px rgba(0, 0, 0, .25), inset 0 1px 0 rgba(255, 255, 255, .03);
+    backdrop-filter: blur(6px);
+    position: relative;
+}
+
+/* halo respirant */
+.card::before {
+    content: "";
+    position: absolute;
+    inset: 0;
+    border-radius: 14px;
+    pointer-events: none;
+    box-shadow: 0 0 0 0 rgba(255, 122, 24, .08), 0 0 0 0 rgba(106, 161, 255, .08);
+    animation: card-glow 5.5s ease-in-out infinite alternate
+}
+
+@keyframes card-glow {
+    0% {
+        box-shadow: 0 0 0 0 rgba(255, 122, 24, .08), 0 0 0 0 rgba(106, 161, 255, .08)
+    }
+
+    100% {
