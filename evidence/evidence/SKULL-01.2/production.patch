+function sanitizeCategoryList(rawCategories) {
+  if (!Array.isArray(rawCategories)) {
+    return [];
+  }
+
+  const seen = new Set();
+  const result = [];
+
+  rawCategories.forEach((item) => {
+    if (typeof item !== "string") {
+      return;
+    }
+
+    const value = item.trim();
+    if (!value) {
+      return;
+    }
+
+    const key = value.toLowerCase();
+    if (seen.has(key)) {
+      return;
+    }
+
+    seen.add(key);
+    result.push(value);
+  });
+
+  return result;
+}
